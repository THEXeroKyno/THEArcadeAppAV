<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="THEArcadeAppAV.Robot"
             Title="Robot">
    <AbsoluteLayout Background="AliceBlue">
        <Label
            TextColor="Goldenrod"
            Text="Tic-Tac-Toe"
            FontAttributes="Bold"
            FontFamily="comic sans"
            FontSize="80"
            AbsoluteLayout.LayoutFlags="PositionProportional"
            AbsoluteLayout.LayoutBounds="0.5, 0.1"
        />
        <Label
            TextColor="Goldenrod"
            Text="Press a square to start!"
            FontFamily="comic sans"
            FontSize="40"
            AbsoluteLayout.LayoutFlags="PositionProportional"
            AbsoluteLayout.LayoutBounds="0.5, 0.25"
        />
        <Grid
            AbsoluteLayout.LayoutFlags="PositionProportional"
            AbsoluteLayout.LayoutBounds="0.5,0.75"
            WidthRequest="600"
            HeightRequest="600"
            BackgroundColor="Goldenrod">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <AbsoluteLayout Grid.Column="0" Grid.Row="0">
                <ImageButton
                    AbsoluteLayout.LayoutFlags="All"
                    AbsoluteLayout.LayoutBounds="0.5,0.5,0.9,0.9"
                    BackgroundColor="AliceBlue"
                    x:Name="square1"
                    Clicked="square1_Clicked"
                />
            </AbsoluteLayout>
            <AbsoluteLayout Grid.Column="1" Grid.Row="0">
                <ImageButton
                    AbsoluteLayout.LayoutFlags="All"
                    AbsoluteLayout.LayoutBounds="0.5,0.5,0.9,0.9"
                    BackgroundColor="AliceBlue"
                    x:Name="square2"
                    Clicked="square2_Clicked"
                />
            </AbsoluteLayout>
            <AbsoluteLayout Grid.Column="2" Grid.Row="0">
                <ImageButton
                    AbsoluteLayout.LayoutFlags="All"
                    AbsoluteLayout.LayoutBounds="0.5,0.5,0.9,0.9"
                    BackgroundColor="AliceBlue"
                    x:Name="square3"
                    Clicked="square3_Clicked"
                />
            </AbsoluteLayout>
            <AbsoluteLayout Grid.Column="0" Grid.Row="1">
                <ImageButton
                    AbsoluteLayout.LayoutFlags="All"
                    AbsoluteLayout.LayoutBounds="0.5,0.5,0.9,0.9"
                    BackgroundColor="AliceBlue"
                    x:Name="square4"
                    Clicked="square4_Clicked"
                />
            </AbsoluteLayout>
            <AbsoluteLayout Grid.Column="1" Grid.Row="1">
                <ImageButton
                    AbsoluteLayout.LayoutFlags="All"
                    AbsoluteLayout.LayoutBounds="0.5,0.5,0.9,0.9"
                    BackgroundColor="AliceBlue"
                    x:Name="square5"
                    Clicked="square5_Clicked"
                />
            </AbsoluteLayout>
            <AbsoluteLayout Grid.Column="2" Grid.Row="1">
                <ImageButton
                    AbsoluteLayout.LayoutFlags="All"
                    AbsoluteLayout.LayoutBounds="0.5,0.5,0.9,0.9"
                    BackgroundColor="AliceBlue"
                    x:Name="square6"
                    Clicked="square6_Clicked"
                />
            </AbsoluteLayout>
            <AbsoluteLayout Grid.Column="0" Grid.Row="2">
                <ImageButton
                    AbsoluteLayout.LayoutFlags="All"
                    AbsoluteLayout.LayoutBounds="0.5,0.5,0.9,0.9"
                    BackgroundColor="AliceBlue"
                    x:Name="square7"
                    Clicked="square7_Clicked"
                />
            </AbsoluteLayout>
            <AbsoluteLayout Grid.Column="1" Grid.Row="2">
                <ImageButton
                    AbsoluteLayout.LayoutFlags="All"
                    AbsoluteLayout.LayoutBounds="0.5,0.5,0.9,0.9"
                    BackgroundColor="AliceBlue"
                    x:Name="square8"
                    Clicked="square8_Clicked"
                />
            </AbsoluteLayout>
            <AbsoluteLayout Grid.Column="2" Grid.Row="2">
                <ImageButton
                    AbsoluteLayout.LayoutFlags="All"
                    AbsoluteLayout.LayoutBounds="0.5,0.5,0.9,0.9"
                    BackgroundColor="AliceBlue"
                    x:Name="square9"
                    Clicked="square9_Clicked"
                />
            </AbsoluteLayout>
         </Grid>
        <Label
            Text=""
            x:Name="Winner_Label"
            AbsoluteLayout.LayoutBounds="0.5, 0.95"
            AbsoluteLayout.LayoutFlags="PositionProportional"
            FontSize="60"
            TextColor="#FF6C421A"
        />
        <Button
            x:Name="newgame"
            Clicked="newgame_Clicked"
            Text="Reset"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0.5, 0.99, 0.2, 0.040"
            TextColor="#FF6C421A"
            FontSize="20" 
            BackgroundColor="Goldenrod"
        />
    </AbsoluteLayout>

</ContentPage>