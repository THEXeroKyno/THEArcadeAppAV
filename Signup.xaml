<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="THEArcadeAppAV.Signup"
             Title="Signup">

             <AbsoluteLayout BackgroundColor="Beige">
                
                    <Label
                    TextColor="Goldenrod"
                    Text="Arcade App Signup"
                    FontAttributes="Bold"
                    FontFamily="comic sans"
                    FontSize="80"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    AbsoluteLayout.LayoutBounds="0.5, 0.2"
                    x:Name="Titleyeah"/>
                    <AbsoluteLayout WidthRequest="400" HeightRequest="150" AbsoluteLayout.LayoutFlags="PositionProportional" AbsoluteLayout.LayoutBounds="0.5, 0.4">
                        
                        <Label Text="Sign up" TextColor="Goldenrod" FontSize="20" AbsoluteLayout.LayoutFlags="PositionProportional" AbsoluteLayout.LayoutBounds="0, 0"/>
                        <Entry x:Name="UsernameEntry" Placeholder="Username: " Background="Goldenrod" AbsoluteLayout.LayoutFlags="SizeProportional,PositionProportional" AbsoluteLayout.LayoutBounds="0, 0.5, 1, 0.2"/>
                        <Entry x:Name="PasswordEntry" Placeholder="Password: " Background="Goldenrod" AbsoluteLayout.LayoutFlags="SizeProportional,PositionProportional" AbsoluteLayout.LayoutBounds="0, 0.8, 1, 0.2"/>

                    </AbsoluteLayout>

                    <Button
                        Text="Sign up!" BackgroundColor="#f9d387" BorderColor="#e88c14" BorderWidth="5" WidthRequest="300" HeightRequest="50" Clicked="Button_Clicked" AbsoluteLayout.LayoutFlags="PositionProportional" AbsoluteLayout.LayoutBounds=" 0.5, 0.5"/>
             </AbsoluteLayout>

</ContentPage>