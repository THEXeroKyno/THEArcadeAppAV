<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="THEArcadeAppAV.Simulator"
             Title="Simulator">
<VerticalStackLayout VerticalOptions="Center">
<AbsoluteLayout Margin="20" x:Name="Canvas" WidthRequest="100">
    <StackLayout x:Name="TopPack" BackgroundColor="#e88c14" WidthRequest="250" HeightRequest="45" AbsoluteLayout.LayoutFlags="XProportional" AbsoluteLayout.LayoutBounds="0.5,50"/>
        <Image x:Name="Card1" AbsoluteLayout.LayoutFlags="XProportional" AbsoluteLayout.LayoutBounds="0.5,55" ZIndex="-1" WidthRequest="230" HeightRequest="300"/>
        <Image x:Name="Card2" AbsoluteLayout.LayoutFlags="XProportional" AbsoluteLayout.LayoutBounds="0.5,55" ZIndex="-1" WidthRequest="230" HeightRequest="300"/>
        <Image x:Name="Card3" AbsoluteLayout.LayoutFlags="XProportional" AbsoluteLayout.LayoutBounds="0.5,55" ZIndex="-1" WidthRequest="230" HeightRequest="300"/>
        <Image x:Name="Card4" AbsoluteLayout.LayoutFlags="XProportional" AbsoluteLayout.LayoutBounds="0.5,55" ZIndex="-1" WidthRequest="230" HeightRequest="300"/>
        <StackLayout x:Name="BottomPack" BackgroundColor="beige" WidthRequest="250" HeightRequest="300" AbsoluteLayout.LayoutFlags="XProportional" AbsoluteLayout.LayoutBounds="0.5,90" />
     </AbsoluteLayout>
   
        <Button
        x:Name="open"
        WidthRequest="400"
        HeightRequest="100"
        BackgroundColor="#f9d387"
        BorderWidth="10"
        BorderColor="#e88c14"
        Text="Open Pack!"
        FontSize="30"
        Clicked="open_Clicked"/>
        <Button
        x:Name="inv"
        WidthRequest="400"
        HeightRequest="100"
        BackgroundColor="#f9d387"
        BorderWidth="10"
        BorderColor="#e88c14"
        Text="View Inventory"
        FontSize="30"
        Clicked="inv_Clicked"/>
    </VerticalStackLayout>
    </ContentPage>