                    FontSize="25"
                    AbsoluteLayout.LayoutBounds="0, 1.025, 1, 0.075"
                    AbsoluteLayout.LayoutFlags="SizeProportional,PositionProportional"/>
                </AbsoluteLayout>
            </Grid>
            <Button
                Text="Inventory"
                x:Name="InvButton"
                Clicked="InvButton_Clicked"/>
