                    AbsoluteLayout.LayoutFlags="SizeProportional,PositionProportional"/>
                </AbsoluteLayout>
                <AbsoluteLayout Grid.Column="0" Grid.Row="2" HeightRequest="400" Padding="10">
                    <ImageButton
                    Source="greenman.jpg"
                    AbsoluteLayout.LayoutBounds="0, 0, 1, 0.8"
                    AbsoluteLayout.LayoutFlags="SizeProportional,PositionProportional"
