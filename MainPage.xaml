                    Text="OPEN SOME CARDS!"
                    FontSize="20"
                    AbsoluteLayout.LayoutBounds="0, 0.95,1,0.075"
                    AbsoluteLayout.LayoutFlags="SizeProportional,PositionProportional"/>
                    <Label
