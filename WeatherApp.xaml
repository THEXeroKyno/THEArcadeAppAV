<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="THEArcadeAppAV.WeatherApp"
             xmlns:vm="clr-namespace:THEArcadeAppAV.Models"
             x:DataType="vm:Weatherinfo"
             Title="WeatherApp">
    <AbsoluteLayout BackgroundColor="Moccasin">
        <Entry x:Name="City" Placeholder="City" TextColor="Black" BackgroundColor="White" Text="{Binding City}" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0.04, 0.02, 0.25, 0.1"/>
        <Entry x:Name="State" Placeholder="State" TextColor="Black" BackgroundColor="White" Text="{Binding State}" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0.4, 0.02, 0.25, 0.1"/>
        <Button x:Name="search" Text="Search" BackgroundColor="tan" Command="{Binding FetchWeatherInformationCommand}" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0.7, 0.045, 0.15, 0.05"/>
        <Label x:Name="yeah" Text="placeholder" FontSize="35" TextColor="Black" BackgroundColor="White" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0.5, 0.15, 0.25, 0.1"/>
        <Label x:Name="number" Text="{Binding Temp}" FontSize="90" TextColor="Black" BackgroundColor="White" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0.2, 0.65, 0.35, 0.4"/>
        <Image Source="{Binding Weather_icon}" AbsoluteLayout.LayoutBounds="1, 0.65, 0.4, 0.5" AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
</ContentPage>